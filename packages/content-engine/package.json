{
  "name": "@dgipr/content-engine",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "scrape:karjamukti": "tsx src/scraping/mahasamvad-rest.ts",
    "chunk:karjamukti": "tsx src/chunking/chunk-articles.ts",
    "embed:karjamukti": "tsx --env-file=../../.env src/embedding/ingest-chunks.ts",
    "scrape:news": "tsx src/scraping/mahasamvad-rest.ts 16 mahasamvad-news 250",
    "chunk:news": "tsx src/chunking/chunk-articles.ts mahasamvad-news news",
    "embed:news": "tsx --env-file=../../.env src/embedding/ingest-chunks.ts mahasamvad-news",
    "ingest:all": "tsx --env-file=../../.env src/scripts/ingest-mahasamvad.ts",
    "seed:reference-library": "tsx --env-file=../../.env src/scripts/seed-reference-library.ts",
    "analyze:references": "tsx --env-file=../../.env src/scripts/analyze-reference-library.ts",
    "intake:test": "tsx --env-file=../../.env src/intake/intake-test.ts",
    "retrieve:test": "tsx --env-file=../../.env src/retrieval/retrieve-references.ts",
    "generate:test": "tsx --env-file=../../.env src/generation/generate-article.ts",
    "generate:simple": "tsx --env-file=../../.env src/generation/generate-article-simple.ts",
    "article:compare": "tsx --env-file=../../.env src/scripts/compare-article-modes.ts",
    "poster:motion:demo": "tsx --env-file=../../.env src/scripts/motionize-poster-demo.ts",
    "what-changed:demo": "tsx --env-file=../../.env src/scripts/what-changed-demo.ts",
    "what-changed:test": "tsx --test src/what-changed/find-topic-articles.test.ts src/what-changed/render-carousel.test.ts",
    "chat:test": "tsx --test src/chat/misc-chat.test.ts",
    "translate:test": "tsx --test src/generation/translate-article.test.ts",
    "polish:test": "tsx --env-file=../../.env src/generation/polish-article.ts",
    "youtube:check": "tsx src/intake/youtube-audio.ts --check"
  },
  "dependencies": {
    "@dgipr/database": "workspace:*",
    "@dgipr/poster-renderer": "workspace:*",
    "@dgipr/schemas": "workspace:*",
    "@google/genai": "^2.18.0",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.6.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "sarvamai": "^1.1.7",
    "sharp": "^0.34.4",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^28.0.3",
    "tsx": "^4.19.2"
  }
}
