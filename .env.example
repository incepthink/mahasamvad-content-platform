SUPABASE_URL
SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# AWS S3 object storage (posters, scene images, video assets, DLO uploads).
#
# Replaced Supabase Storage on 2026-08-09. Supabase still serves the DATABASE —
# the three vars above are still required. Only the files moved.
#
# The database stores object PATHS, never URLs, so nothing was migrated in SQL:
# an S3 key is byte-identical to what the row already held.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Real S3 bucket names. S3 names are globally unique across ALL AWS accounts, so
# these cannot be 'posters'/'videos' — the code uses those as logical names and
# resolves them through here. Pick any unique names; these are only suggestions.
S3_BUCKET_POSTERS=dgipr-posters
S3_BUCKET_VIDEOS=dgipr-videos
S3_BUCKET_DLO_UPLOADS=dgipr-dlo-uploads

# S3 Transfer Acceleration — set this to true for LOCAL DEVELOPMENT ONLY.
#
# Leave it unset on the EC2 box: the API runs in us-east-2 beside the buckets,
# where accelerating buys nothing and costs $0.04/GB.
#
# From a machine far from us-east-2 (i.e. a laptop in India) a single TCP
# connection to the bucket is loss-limited to ~26 KiB/s, so a 6.4 MB poster took
# 198 s and intermittently died with ECONNRESET — failing the job AFTER the image
# model had been billed. Over the accelerate endpoint the same upload takes 2.3 s.
#
# The buckets already have Status=Enabled; this flag only chooses which endpoint
# THIS process talks to.
# S3_USE_ACCELERATE=true

# Downloading an object is bounded by an IDLE timeout on the response body, not
# by a total duration — a big video clip on a slow link keeps its time as long as
# bytes keep arriving. This exists because the AWS client's own requestTimeout
# stops applying once the response headers land, so a connection that goes silent
# mid-body used to be awaited forever: a video animate job sat on a half-read
# scene still for two hours, which also stopped the orphan reaper from freeing
# the project (the job never settled, so it still counted as running).
#
# Raise it if a genuinely slow bucket trips it; a stall retries S3_DOWNLOAD_ATTEMPTS
# times (downloads are free) before the job fails.
# S3_DOWNLOAD_IDLE_TIMEOUT_MS=60000
# S3_DOWNLOAD_ATTEMPTS=3

# Uploading a meeting recording is a STREAM, not a buffer: an upload route forwards each
# part to S3 in fixed-size pieces as it arrives, so a 240 MB recording costs about
# PART_BYTES x CONCURRENCY of memory instead of ~500 MB. That is what makes "no size limit"
# something the box can survive — before 2026-08-30 the whole file was assembled in the API
# process and a 239.6 MB upload killed the container mid-transfer.
#
# Leave these alone unless you are tuning memory: the part size is also S3's floor (5 MiB
# minimum per part, 10,000 parts maximum, so 8 MiB covers files up to 80 GB) and lowering
# the concurrency mostly just makes uploads slower.
#
# Verify the whole path against a real bucket, cheaply and without touching the product:
#   pnpm --filter @dgipr/database storage:check-upload -- --mb=240
# It needs CreateMultipartUpload / UploadPart / CompleteMultipartUpload / AbortMultipartUpload
# on the private bucket — a policy granting only s3:PutObject passes every OTHER upload in the
# product and fails every recording.
# S3_UPLOAD_PART_BYTES=8388608
# S3_UPLOAD_CONCURRENCY=2

# How many bytes of audio a transcription job may hold at once. Recordings are downloaded
# and transcribed in groups bounded by this, so ten two-hour recordings can no longer all be
# resident (which is the same failure as above, moved one step later). A single recording
# LARGER than the budget is never refused — it simply gets a group to itself.
# STT_BATCH_MAX_BYTES=268435456

# CloudFront domains serving the two PUBLIC buckets (one distribution each).
#
# OPTIONAL: unset, the code falls back to the direct S3 URL so the stack works
# before CloudFront finishes propagating. Do not leave them unset in production
# — that means paying S3 egress rates and serving Indian users from us-east-2
# on every poster and video. Setting them needs no redeploy of anything else.
#
# There is deliberately NO entry for the dlo-uploads bucket: it holds officers'
# meeting recordings and source documents, is read server-side only, and asking
# it for a public URL throws.
# CLOUDFRONT_POSTERS_URL=https://d111111abcdef8.cloudfront.net
# CLOUDFRONT_VIDEOS_URL=https://d222222abcdef8.cloudfront.net

OPENAI_API_KEY
CANVA_CLIENT_ID
CANVA_CLIENT_SECRET

# OpenAI models (all optional — defaults shown). Every OpenAI text/vision call in the repo
# runs on the gpt-5.6 family, in two tiers. Changing models is an edit HERE, not in code.
#
#   OPENAI_CHAT_MODEL     — authoring + judgement: article generation and revision, the
#                           coverage/faithfulness checks, captions, proof-read. The default
#                           for any call that does not name a model.
#   OPENAI_UTILITY_MODEL  — mechanical work whose answer a deterministic step re-checks:
#                           master ranking tie-breaks, page-instruction parsing, offline
#                           finetune data prep.
#   OPENAI_VISION_MODEL   — image-input calls (poster feedback markers, master analysis).
#                           MUST be vision-capable.
#   OPENAI_VIDEO_MODEL    — the /video pipeline's TEXT calls (scene planning, script
#                           writing, narration shortening, coverage checks), pinned one
#                           step up because they are the judgement-heaviest Marathi work.
#                           Text only: the clips stay on Kling and the frames on Gemini.
#   OPENAI_ARTICLE_MODEL  — the SIMPLIFIED article generator's single call (see
#                           ARTICLE_GENERATION_MODE below). Pinned one step up for the same
#                           reason as the video tier: with the brief, the coverage loop and
#                           the faithfulness repair removed, all of that judgement now
#                           happens inside this one call.
#   OPENAI_POINTERS_MODEL — /dlo's महत्त्वाचे मुद्दे summary. Pinned one step up because
#                           enumerating every distinct topic across a 60k-char multi-article
#                           document, in order and without repeating itself, is a
#                           judgement-heavy read — and it is the officer's only view of what
#                           a long scanned source says. Dropping it to terra halves the
#                           per-run cost (~$0.10 short note / ~$0.40-0.50 long PDF on sol).
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_UTILITY_MODEL=gpt-5.6-luna
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_VIDEO_MODEL=gpt-5.6-sol
# OPENAI_ARTICLE_MODEL=gpt-5.6-sol
# OPENAI_POINTERS_MODEL=gpt-5.6-sol
#
# Rollback lever: setting these three to gpt-4o / gpt-4o-mini / gpt-4o-mini restores the
# pre-5.6 behaviour exactly (the pre-gpt-5 request body is preserved byte-for-byte).
#
# gpt-5.6 notes that matter operationally:
#  - `temperature` is REJECTED, so the temperature-0 determinism ~24 call sites used to
#    rely on is gone. Reasoning effort ('medium' by default) is the replacement quality
#    lever; the deterministic post-filters (proof-read's verbatim-excerpt + digit guards,
#    lock-scheme-names, the translate name repair, the video fact_index grounding) are
#    what actually hold the line and are unchanged.
#  - Reasoning tokens are billed at the OUTPUT rate and come out of the same completion
#    budget as the answer, so expect a real cost increase per article vs gpt-4o. The
#    per-run number lands in generations.cost_usd.

# Which article pipeline runs for news/scheme generation (optional — default 'simple').
#
#   simple  the single-call baseline: one style reference, one call on OPENAI_ARTICLE_MODEL,
#           one article. No 5W1H extraction, no editorial brief, no tier audit, no sectioned
#           drafting, no coverage-revision loop, no faithfulness repair, no traceability
#           appendix. ~1 chat call instead of up to 14.
#   full    the previous multi-stage editorial pipeline, unchanged. generate-article.ts and
#           every stage module it calls are untouched, so this restores the old behaviour —
#           and the old model — exactly.
#
# Everything deterministic and everything officer-approved survives in BOTH modes: the
# designation pass, and — for generations created while /dlo's Pointers step was a 5W1H
# checkbox list — the stored approved inventory, attributed statements and excluded facts.
# New /dlo runs no longer carry an inventory: Pointers is now a read-only summary and the
# article is written from the complete reviewed text.
# ARTICLE_GENERATION_MODE=full

# Historical Mahasamvad style references are temporarily bypassed in the simplified article
# generator (optional — default false). While disabled, the engine performs no reference
# embedding/retrieval call, ignores an officer-pasted style article, and uses the dedicated
# no-reference prompt. Set true to restore the complete existing reference hierarchy and its
# original prompts without a code change.
# ARTICLE_STYLE_REFERENCES_ENABLED=true

# Publication place used in the mandatory dateline at the start of every generated NEWS body.
# The date is always today's day-of-month in Asia/Kolkata and is rendered in Devanagari digits
# (for example, "मुंबई, दि. २९ :"). Scheme articles and officer-provided finished articles are
# unchanged. Optional — default 'मुंबई'.
# ARTICLE_NEWS_DATELINE_LOCATION=मुंबई

# Which editorial specification writes that article (optional — default 'standard').
# Independent of ARTICLE_GENERATION_MODE above: that chooses the PIPELINE, this chooses the
# PROMPT the single call runs.
#
#   standard  the full DGIPR specification (simple-article-prompt.ts, ~6,900 chars): structure
#             guidance, ordering rules, terminology examples.
#   minimal   the experiment (minimal-article-prompt.ts, ~830 chars): the note, the style
#             exemplars, the verified name dictionary, and five sentences of instruction.
#
# NEITHER states a word target any more (simple-v3, 2026-07-28: the count and the acceptable
# range came out of the standard specification too — a stated number is an instruction the model
# obeys against the material, padding a thin note and truncating a rich one). Length is
# inherited from the exemplars, which are themselves bounded by styleReferenceMaxChars() in
# select-style-reference.ts (ARTICLE_WORD_TARGETS[category].max x 6.5 x 2). If articles come out
# the wrong length in EITHER variant, THAT bound is the knob, not a sentence in the prompt.
#
# Everything outside the prompt is identical between the two — same reference selection, same
# model, same deterministic designation pass — which is what makes them comparable. Each run
# records which one wrote it in generations.style_reference_meta.promptVersion
# ('simple-v3' vs 'minimal-v1').
# ARTICLE_PROMPT_VARIANT=minimal

# Deliberation for that one call (optional — default 'high'; none | low | medium | high).
# This is the knob that replaced the removed grading passes, and it matters more under the
# minimal variant, where the specification is five sentences and the judgement that used to be
# spread over fourteen calls has nowhere else to happen. 'high' costs latency, not correctness;
# set 'medium' to restore the previous default. Compare levels on real notes with
# `pnpm --filter @dgipr/content-engine article:compare -- --effort=high`.
# OPENAI_ARTICLE_REASONING_EFFORT=high

# Minimum cosine similarity (0..1) a retrieved Mahasamvad article must reach before it is used
# as the style reference (optional — default 0.35). Below the floor the article is generated
# from the DGIPR rules alone, which is better than being shown an unrelated exemplar and told
# to follow its structure. CALIBRATE THIS against the live corpus rather than guessing: run
# `pnpm --filter @dgipr/content-engine retrieve:test` over real notes to see the distribution,
# and read generations.style_reference_meta to see what production runs actually matched.
# ARTICLE_STYLE_REFERENCE_MIN_SIMILARITY=0.35

# Model for the poster's reference selection + visible Marathi copy + art direction. Split from
# OPENAI_CHAT_MODEL so the poster path can be tuned for latency independently — set it to
# gpt-5.6-luna to trade some copy quality for a faster render.
# OPENAI_COPY_MODEL=gpt-5.6-terra

# How an ordinary (unpinned, non-CMO) social poster picks its reference template
# (optional — default 'information').
#
#   information  INFORMATION-FIRST. The raw note is compared against EVERY enabled master of
#                the brand — across all types — using each master's cached informational
#                description (reference_images.layout_spec), and the best-fitting reference
#                wins. The poster type is then read off the chosen reference, and the copy
#                step arranges the note's information into the sections that reference
#                actually has. Nothing about the note is predicted beforehand.
#   classify     LEGACY. Classify the note into a post type and read point_count +
#                wants_photo off the same call, then score masters WITHIN that type. Every
#                prediction made there constrained the pool before a reference had been
#                looked at: a wrong point_count excluded the right template, a wrong
#                post_type excluded a whole family of them.
#
# One un-analysed master is warmed per run on BOTH paths, but information-first can only rank
# masters that already carry a description — so run
# `pnpm --filter @dgipr/content-engine analyze:references` to backfill the library, or early
# runs fall back to the seeded pick.
# SOCIAL_REFERENCE_MODE=classify

# OpenAI transport (all optional — defaults shown). Every chat/embedding call is serialized
# process-wide and retried on transient failures (429 / 408 / 409 / 5xx / network), preferring
# the wait OpenAI names in its retry-after / x-ratelimit-reset-* headers.
# One scheme article is 8-15 calls carrying the full note and article (~5-8k tokens each),
# so at OpenAI usage tier 1 (30,000 TPM) concurrency MUST stay at 1 — two in-flight requests
# will trip the token bucket. Reasoning tokens count toward TPM too, so this matters MORE on
# gpt-5.6, not less. Raise it only on tier 2+ (450k TPM), where it restores real
# parallelism to the coverage checks and cuts wall-clock noticeably.
#
# THIS IS THE KNOB THAT DECIDES WHETHER SEVERAL OFFICERS CAN WORK AT ONCE. /dlo now supports
# concurrent intakes (each at its own /dlo/[id]), but every OpenAI call in the process still
# queues through this limiter — so at 1, a second officer's pointer summary or article simply
# waits behind the first with no sign of why. Recommended deployment value: 5, and ONLY on
# tier 2+. The arithmetic: an article is ~120k tokens spread over minutes, so five officers
# aggregate to roughly 150k TPM in steady state; the exposure is the burst case (five large
# calls in one minute, ~600k), which retry-with-backoff absorbs. Expect
# "[openai] ... got 429" warnings to become ROUTINE at 5 — that is the mechanism working, but
# it does mean the log stops being a useful signal that something is wrong. If throughput
# feels worse rather than better, that is the symptom of overshooting the tier: drop to 3.
# On tier 1, raising this makes things worse. Rollback is this one line.
# OPENAI_MAX_CONCURRENCY=1
# OPENAI_MAX_RETRIES=5              # retries AFTER the first attempt
# Per-request timeout; a hung call would otherwise block the serialized queue. Raised from
# 180000 for gpt-5.6: a full-length Marathi article body at 'medium' reasoning can run
# longer than 3 minutes, and this timeout aborts it mid-generation.
# DEPLOYMENT CHECK: /api/pointers is synchronous, so a queued request can hold an HTTP
# connection open for this long plus queue time. Confirm the reverse proxy's idle timeout is
# >= 310s, or lower this to fit under it — otherwise the proxy 504s and throws away a call
# that has already been paid for.
# OPENAI_REQUEST_TIMEOUT_MS=300000

# NOTE: the API must run as EXACTLY ONE process. The detail routes reap "orphaned" jobs by
# checking an in-process set (see apps/api/src/routes/dlo.ts), so a second instance behind a
# load balancer would mark healthy jobs running on the first instance as failed. Scaling
# horizontally requires replacing that check with a heartbeat + grace window in dlo-runner.ts,
# runner.ts and video-runner.ts alike.

# Which engine transcribes meeting recordings on BOTH lanes (/transcribe and /dlo).
# `elevenlabs` (DEFAULT — materially better Marathi on real meeting audio) or `sarvam`,
# which is the one-line rollback to the batch-STT path. ElevenLabs needs ELEVENLABS_API_KEY
# (shared with the video narration block below); Sarvam needs SARVAM_API_KEY. Note that
# ElevenLabs has no batch job — recordings are POSTed a few at a time — so a multi-recording
# intake takes longer than one Sarvam job, at the same price.
# STT_PROVIDER=elevenlabs
# scribe_v1 is the transcription flagship. The language is pinned to Marathi as ISO-639-3
# `mar` (NOT the mr-IN tag Sarvam takes); left to auto-detect, Marathi with English
# loanwords can come back as Hindi or transliterated, which Devanagari hides.
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_STT_LANGUAGE=mar
# ELEVENLABS_STT_CONCURRENCY=2      # parallel recordings; low on purpose (plan limits)
# ELEVENLABS_STT_TIMEOUT_MS=1200000 # 20 min, per RECORDING (not per intake)

# ---------- pasted media links (YouTube) ----------
# Where a pasted link's audio comes from. `download` (DEFAULT) fetches it on this server
# with yt-dlp and hands the STT provider ordinary bytes; `provider` passes the link along
# for the provider to fetch, which is what this product did until 2026-08-19 and which only
# ElevenLabs can serve.
#
# The default changed because ElevenLabs' `source_url` stopped being able to fetch YouTube —
# EVERY video comes back `Failed to download the file from the provided URL (upstream status
# 400)`, i.e. what YouTube answered THEM. A plain hosted MP3 URL still works through the same
# parameter, so `provider` is the rollback for the day their YouTube support returns.
# YOUTUBE_AUDIO_SOURCE=download
#
# The binary. The API image installs it to /usr/local/bin/yt-dlp (deploy/api.Dockerfile);
# set this only for a local checkout or an unusual install path.
# YTDLP_PATH=yt-dlp
# YOUTUBE_DOWNLOAD_MAX_BYTES=536870912  # 512 MiB — a runaway guard, hours of audio
# YOUTUBE_DOWNLOAD_TIMEOUT_MS=1200000   # 20 min, per LINK
#
# THE ONE THING THAT CAN STILL FAIL is YouTube refusing THIS SERVER's address — a datacentre
# IP is exactly what its bot checks are aimed at, and that question is separate from whether
# it refuses ElevenLabs'. Check it in 30 seconds from the box itself:
#   docker run --rm python:3.12-slim sh -c \
#     'pip install -q yt-dlp && yt-dlp -f bestaudio --no-playlist -g "https://youtu.be/dQw4w9WgXcQ"'
# A googlevideo URL means it is fine. `Sign in to confirm you're not a bot` / HTTP 403 means
# it is not, and these are the answers — a cookies file exported from a signed-in browser,
# or an outbound proxy on a residential address. The job reports that failure by name.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YTDLP_PROXY=http://user:pass@host:port
# Extra yt-dlp arguments, whitespace-separated, appended last. The escape hatch for
# YouTube's churn (a player-client override, a JS runtime) without a code change:
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android

# Sarvam API key — REQUIRED for document digitization of PDFs on /dlo, for the optional
# polish (below) and for the translation feature; also for speech-to-text when
# STT_PROVIDER=sarvam. Get it from dashboard.sarvam.ai.
# SARVAM_API_KEY=sk_xxx
# DLO intake timeouts (optional — defaults shown): overall ceiling per Sarvam batch
# STT job / per document-digitization job before the file is marked failed.
# SARVAM_STT_TIMEOUT_MS=1200000     # 20 min
# SARVAM_DOC_TIMEOUT_MS=600000      # 10 min

# Whether a PDF's own text layer is consulted at all, on EVERY surface (\dlo, \translate,
# \proofread, the media room). Default 'ocr': every PDF is READ BY A MODEL, because (a) the
# local pdf.js text layer returns a table as one run-on line with its figures detached from
# their headings, and government material is full of tables; and (b) these documents are
# routinely typeset in a legacy non-Unicode Marathi font whose text layer decodes to
# convincing junk — नोंदणी as नोंिणी, निर्णय as ननणणय — which would flow into an article as a
# corrupted name. Reading the pixels is the only backend that gets those characters right.
# What that costs: every PDF is billed per selected page, born-digital ones included, and no
# upload can show free preview text, so every PDF stops at the page picker.
# 'auto' restores the previous policy exactly — text layer first, OCR only on a bad verdict.
# PDF_EXTRACTION_MODE=ocr           # ocr (default) | auto

# WHICH model reads it (the seam is packages/content-engine/src/intake/ocr-provider.ts, the
# twin of STT_PROVIDER above). Default 'sarvam': selected pages are packed into ≤10-page PDFs
# and submitted to Document AI Digitise as printed Marathi, with structured HTML output.
# 'openai' is the one-line rollback: one call per page, run in parallel, returning Markdown.
# Not a cost-free swap: Sarvam bills per page against SARVAM_API_KEY's credits and is estimated
# in the OCR task bucket; OpenAI bills tokens against OPENAI_API_KEY through chat usage.
# OCR_PROVIDER=sarvam               # sarvam (default) | openai | gemini
#
# A PHOTOGRAPH of a document (/dlo's प्रतिमा card) follows OCR_PROVIDER too, since 2026-08-27:
# Digitise takes an image as the same job it takes a PDF — it just asks for Markdown instead of
# HTML, because that transcript is edited in a plain box and becomes the article's source text
# verbatim. Measured on one rendered Marathi page: Sarvam read ५०० कोटी correctly in 11s where
# OpenAI returned ७०० कोटी in 33s, which is the Devanagari-digit weakness that path was always
# known to have. Set IMAGE_OCR_PROVIDER only to split the two — it is REQUIRED if OCR_PROVIDER
# is 'gemini', which has no image path; a photograph then fails naming this variable.
# IMAGE_OCR_PROVIDER=sarvam         # sarvam (default, follows OCR_PROVIDER) | openai
# Bounds the upload without throwing away print (~250 dpi across an A4 page). Deliberately not
# OpenAI's 768-shortest-side rule: Sarvam reads the pixels itself, so squeezing a page that far
# drops the matras before its OCR ever sees them.
# SARVAM_IMAGE_LONG_EDGE=3000
#
# /chat PDFs no longer use this extraction backend. They go through Gemini Files as native
# model input and are answered directly by the stateful Interactions API (settings below).
# CHAT_OCR_PROVIDER remains only for the legacy DOCX/TXT intake path and rollback compatibility.
# Selected server-side from the surface the upload declares, never by the browser. Set this to
# `sarvam` or `openai` to put chat back on the shared default; OCR_PROVIDER is unaffected
# either way, so the surfaces whose output gets published do not move.
# CHAT_OCR_PROVIDER=gemini          # gemini (default) | sarvam | openai
# GEMINI_OCR_MODEL=gemini-3.7-flash # must accept a PDF as inline data; the ids churn
# How many pages one Gemini call may carry. NOT the model's 1,000-page input ceiling: the
# binding limit is how much TEXT one ANSWER can hold, and a page of dense Marathi is ~800-1,500
# output tokens. Too high truncates the answer, which the code detects (finishReason
# MAX_TOKENS, or an entry count that does not match the pages sent) and recovers from by
# re-reading that chunk in halves and lowering the budget for the rest of the process. Raise it
# for born-digital documents with little text per page.
# GEMINI_OCR_MAX_PAGES=30
# GEMINI_OCR_MAX_OUTPUT_TOKENS=65536
# Google documents 50 MB per PDF; a request may have a lower inline ceiling. Not worth
# hardcoding a guess — a size rejection lowers this for the process and re-reads in halves.
# GEMINI_OCR_MAX_REQUEST_BYTES=52428800   # 50 MiB
# GEMINI_OCR_MAX_CONCURRENCY=2      # its own Gemini lane, beside the Veo and frame lanes
# GEMINI_OCR_TIMEOUT_MS=900000      # 15 min: one call can transcribe tens of pages

# OPENAI_OCR_MODEL=gpt-5.6-terra    # must accept file input; defaults to the vision tier
# OPENAI_OCR_TIMEOUT_MS=300000      # 5 min, per page
# Reasoning effort for the read. UNSET sends no field, which is the default. Worth knowing
# before reaching for it: 'high' was measured on the image path and did NOT fix Devanagari
# digits — transcription is perception, not deliberation, and effort cannot make obscured
# pixels clearer. It costs latency on every page, so measure before keeping it.
# OPENAI_OCR_REASONING_EFFORT=high
# The biggest request the OCR path will build, which is what bounds a CONTEXT CHUNK. Each page
# is read with its chunk attached, so the surrounding pages are what let the model resolve a
# name obscured on one page and printed clearly on another — a bigger cap means more context.
# Budgeted against the RAW PDF; the base64 actually sent is ~4/3 of it, and the code already
# takes that inflation off. Most uploads become a single chunk (i.e. the whole document); a
# 400-page scan becomes several and each page still gets its neighbourhood.
# OPENAI_OCR_MAX_REQUEST_BYTES=52428800   # 50 MiB
# How many pages are read at once. Its own lane, deliberately: OPENAI_MAX_CONCURRENCY=1 above
# serializes the article pipeline, and putting a 20-page document behind that gate would make
# the per-page design the slowest way to read a document rather than the fastest. This is the
# main lever on how long a long document takes — a 400-page scan is 400 calls, so 4 at a time
# is hours and 16 is not. Raise it as far as the org's TPM tier can take the burst; lower it if
# the API log fills with 429 retries.
# OCR_MAX_CONCURRENCY=16
# Ceiling on how many pages ONE read may cover. SARVAM ONLY — the openai path no longer has a
# page ceiling at all (2026-08-14), by explicit decision: a 400-page document is 400 paid reads
# and that is the officer's call to make, not a number in here. The consequence to know is that
# /chat has no page picker (it reads the whole document on send), so on the openai path nothing
# now stands between a long scan and its full cost.
# SARVAM_DOC_MAX_TOTAL_PAGES=50     # sarvam path only

# ---- चॅट (/chat), the general assistant ----
# Its own lane too, and for a sharper reason than OCR's: someone is WATCHING a chat answer. A
# pipeline job that waits ninety seconds for a slot is a progress bar moving slightly later; a
# chat that does is broken. This also keeps the traffic pointing the other way — an officer's
# article never queues behind someone else's chat. Lower to 1 to make chat strictly
# one-at-a-time while still keeping it out of the pipeline's way.
# CHAT_MAX_CONCURRENCY=4
# The model. Chat uses OpenAI Responses directly for text, images and original PDFs; it does
# NOT run the publishing pipeline's page-by-page OCR first. Files are uploaded once and a
# stored response id carries conversation state, so normal follow-ups send only the new turn.
# sol is the TOP text tier and the default here. Every other surface runs on terra because a
# deterministic post-filter re-checks its work; /chat has none, so the single call is the whole
# product. Roughly 2x terra per token — set terra to trade quality for cost.
# OPENAI_MISC_CHAT_MODEL=gpt-5.6-sol
# Deliberation is dialled down for an interactive surface: reasoning happens before the first
# token, so raising this delays the moment the answer starts appearing. The answer itself is
# streamed token by token, and a turn that never reaches `completed` is stored with its error.
# OPENAI_MISC_CHAT_REASONING_EFFORT=low
# OPENAI_MISC_CHAT_TIMEOUT_MS=300000
# OPENAI_MISC_CHAT_MAX_OUTPUT_TOKENS=16384
# PDF page-image detail: auto (gpt-5.6 chooses high), low or high. Text is always extracted.
# OPENAI_MISC_CHAT_PDF_DETAIL=auto

# Whether the content-addressed transcript cache (audio_transcript_cache, migration 0031) is
# READ before calling the STT provider, on BOTH lanes (\transcribe and \dlo). Default 'off':
# every run transcribes its recordings afresh, so re-submitting the same MP3 is a real, billed
# job again — a transcript is the deliverable, and silently serving an older one hides a
# re-run that was asked for. 'read' restores the reuse behaviour. The WRITE happens either
# way, which is what makes 'read' a working rollback rather than a cold start; a run's own
# transcript is stored on its row regardless, so history never depends on this.
# BEFORE SETTING 'read': the key is a hash of the audio BYTES ALONE and does not record which
# provider produced a transcript, so a recording first run through the other STT_PROVIDER is
# served from the cache — invisibly, in Devanagari.
# TRANSCRIPT_CACHE_MODE=off

# English translation and optional Marathi editor-polish use Sarvam-105B. Polish is off by
# default and improves flow/tone only,
# never facts; the existing faithfulness check runs after it. Requires SARVAM_API_KEY when on.
# Sarvam models are hybrid-reasoning; reasoning is disabled by default here (it only burns
# the token budget on a copy-edit task). Both knobs below are optional — defaults shown.
# ENABLE_SARVAM_POLISH=true
# SARVAM_MODEL=sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1/chat/completions
# SARVAM_MAX_TOKENS=4096            # budget covers reasoning + reply; Sarvam's default 2048 is too low.
#                                  # NOTE: the starter tier caps sarvam-105b max_tokens at 4096 — do not
#                                  # raise this above your plan's limit or requests 400.
# SARVAM_REASONING_EFFORT=none      # none|low|medium|high — 'none' disables thinking (default)

# Marathi→HINDI translation uses Sarvam's dedicated translation endpoint, not the chat model
# above (the chat model returns the Marathi unchanged when asked for Hindi). Needs only
# SARVAM_API_KEY; both knobs are optional overrides — defaults shown.
# SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Which TTS engine voices the explainer video. `sarvam` (default) or `elevenlabs`; the
# narrate/storyboard gate names whichever key the selected provider needs, so an
# ElevenLabs deployment holds no Sarvam key at all. Rollback is this one line.
# NARRATION_TTS_PROVIDER=sarvam
#
# ElevenLabs (only when NARRATION_TTS_PROVIDER=elevenlabs). The voice id is REQUIRED and
# has no default — a plausible-but-wrong id would narrate a whole video in the wrong voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# eleven_v3 is the expressive flagship but exposes NO speed control. Use
# eleven_multilingual_v2 when the narration has to be fitted to a fixed window — it takes
# ELEVENLABS_SPEED (0.7–1.2), and v3 rejects that field outright.
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_SPEED=1.0
# Voice settings are ALL opt-in: omitted means "use the voice's own saved setting". v3
# additionally constrains stability to exactly 0.0, 0.5 or 1.0.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.0
# ELEVENLABS_SPEAKER_BOOST=true
# Raw PCM is requested and the WAV header is written locally (the pipeline measures RIFF
# chunks). pcm_44100 is plan-gated; a rejection falls down the 24000/22050/16000 ladder and
# is cached for the process, so this pin is rarely needed.
# ELEVENLABS_SAMPLE_RATE=44100
#
# SPOKEN RATE — chars of Devanagari per second. 16.5 is MEASURED on bulbul and is the
# default; ElevenLabs reads the same Marathi at ~10.9. Set this whenever you set
# NARRATION_TTS_PROVIDER, because on the READY-SCRIPT lane (तयार संहितेवरून) the scene
# count is ceil(estimatedSeconds / 15) and the words may never be trimmed or sped up — a
# rate that is too fast plans too few clips and the narrate gate then REFUSES the project
# after the officer has approved it. NEXT_PUBLIC_ is what makes the create form's estimate
# agree with the server (the browser cannot read server env).
# NARRATION_CHARS_PER_SECOND=16.5
# NEXT_PUBLIC_NARRATION_CHARS_PER_SECOND=16.5

# Explainer-video narration (\video → "निवेदनाचा आवाज जोडा") uses Sarvam TTS (bulbul) to
# voice each scene's Marathi narration. Needs only SARVAM_API_KEY; both knobs are optional —
# defaults shown. If the account lacks bulbul:v3 access, set SARVAM_TTS_MODEL=bulbul:v2 and a
# v2 speaker (e.g. anushka). Voice ids: dashboard.sarvam.ai / the TTS docs.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh           # v3's own default voice; measured, authoritative
# 44100 matches what the ffmpeg mux resamples to anyway, so asking for it removes an
# upsample. v3 accepts up to 48000 over REST.
# SARVAM_TTS_SAMPLE_RATE=44100
# Lower than Sarvam's 0.6 default: steadier reads across eight scenes matter more than
# expressiveness here, and higher values are documented to introduce artifacts. v3 only.
# SARVAM_TTS_TEMPERATURE=0.5
# Retired knob (kept for reference): clip windows are no longer fitted to measured
# narration — every scene is the fixed 8s interpolation window, and an overrunning
# narration is SHORTENED (and re-synthesized) rather than sped up. The env var is unread;
# the real budget lives in packages/schemas/src/video.ts
# (VIDEO_NARRATION_TARGET_SECONDS / _FIT_SECONDS).
# VIDEO_NARRATION_CHARS_PER_SECOND=32

# apps/api (all optional — defaults shown)
# HOST=127.0.0.1
# PORT=3001
# CORS_ORIGIN is a comma-separated list of browser origins the API answers. An entry is
# either an exact origin or a pattern containing `*`, which stands for ONE hostname label
# (it matches no dot and no slash, so a pattern cannot widen past its own domain). The
# wildcard exists for Vercel, where a deployment gets a fresh hostname on every push and a
# branch alias only lasts as long as the branch, so exact preview URLs mean editing this
# value whenever anyone opens one. See apps/api/src/cors-origins.ts; free harness:
# `npx tsx apps/api/src/cors-origins.ts`.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://newsroom.indicex.xyz,https://mahasamvad-content-platform-web-*.vercel.app,https://staging.hashcase.tech

# Canva Connect API. Create an integration at canva.com/developers, enable
# asset:read, asset:write and design:content:write, then register the redirect URI below
# exactly. Canva accepts 127.0.0.1 for local redirects, not localhost. Tokens are used only
# for the one poster handoff and are never persisted by this application.
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=http://127.0.0.1:3001/api/canva/callback

# Poster background image (all optional). The image model now paints ONLY a text-free
# photo; the poster's Marathi text/header/footer are typeset in HTML and screenshotted
# with Chromium, so Devanagari is always crisp regardless of the image model.
# OPENAI_IMAGE_MODEL defaults to gpt-image-2 (gpt-image-1 is deprecated). This is
# SHARED with the video storyboard frames when VIDEO_IMAGE_PROVIDER=openai, so
# changing it moves both. `chatgpt-image-latest` is a floating alias tracking the
# ChatGPT product's own image model — usable, but it can change under a running
# deployment without notice, so prefer a pinned id here.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1536x1024   # landscape scene, cover-cropped into the photo zone
# OPENAI_IMAGE_QUALITY=high

# Model for the reference-master vision analysis (analyze:references / on-demand analysis).
# It reads a master's layout AND its subject off the image, so it MUST be VISION-capable.
# Defaults to gpt-5.6-terra (keeps Marathi in Devanagari; runs once per master and is cached).
# If a gpt-5.6 model ever rejects image input, set this to gpt-4o (also vision-capable).
# OPENAI_ANALYZE_MODEL=gpt-5.6-terra

# n8n social-post workflow (webhook trigger of social-post-v2-api). Required for the
# 'twitter' generation category — the API's background job POSTs meeting notes here and
# awaits { post_type, title, caption, poster_png_base64 }. The workflow is host-independent:
# it fetches its brand templates over HTTPS from the public poster bucket (references/*,
# CloudFront-served since the 2026-08-09 S3 migration; the API sends the full URL), so the
# same exported JSON (n8n/workflow-exports/social-post-v2-api.json) runs locally and on AWS.
#   LOCAL:  http://localhost:5678/webhook/dgipr-social-post
#   AWS:    the deployed n8n webhook URL — a private VPC address if the API and n8n share a
#           network, otherwise the public HTTPS URL of the n8n instance.
N8N_SOCIAL_POST_WEBHOOK_URL=http://localhost:5678/webhook/dgipr-social-post
# n8n webhook for the ARTICLE poster (news/scheme, outputType poster/both). Like the
# social-post workflow, the API sends only { headline, scene_brief, generation_id } and
# n8n *only renders*: it edits the master-article template (posters/references/master-
# article.png, fetched over HTTPS) with gpt-image-2 and returns { poster_png_base64 }.
# The exported JSON is n8n/workflow-exports/article-poster-v1-api.json.
#   LOCAL:  http://localhost:5678/webhook/dgipr-article-poster
#   AWS:    the deployed n8n webhook URL (private VPC address if shared network, else public HTTPS).
N8N_ARTICLE_POSTER_WEBHOOK_URL=http://localhost:5678/webhook/dgipr-article-poster
# Article poster renderer: 'n8n' (default) renders via the workflow above; 'html' uses the
# original local AI-photo + HTML/Playwright render (packages/poster-renderer). Only the
# 'html' path produces a separate scene image, so poster feedback / manual copy-edit
# (which need a scenePath) work only in 'html' mode.
# ARTICLE_POSTER_MODE=n8n
# Base URL of THIS api, reachable from n8n. Used to build the progress_url that n8n
# pings after each stage (local: http://localhost:3001; on AWS the API's internal URL).
API_PUBLIC_URL=http://localhost:3001
# Shared secret between the API and n8n. When set, the API sends it as the
# x-n8n-webhook-secret header on the webhook call. To ENFORCE it on the n8n side (AWS),
# set the workflow's Webhook node Authentication to "Header Auth" and create a Header Auth
# credential with Name = x-n8n-webhook-secret and Value = this secret — n8n then rejects
# mismatches with 403 before the workflow runs. (This keeps the secret in an n8n credential,
# not in the committed workflow JSON, and needs no in-node env access.) Leave unset locally:
# with Header Auth off, the webhook is open, which is fine behind localhost.
# N8N_WEBHOOK_SECRET=

# Shipping workflow changes to a running n8n (`pnpm n8n:push`). n8n stores workflows in its
# own database, NOT on disk — a `git pull` on the n8n host changes nothing. `pnpm n8n:push`
# pushes n8n/workflow-exports/*.json into the instance below over its public REST API,
# matching by workflow name and preserving that instance's credential ids + webhook Header
# Auth. Point it at whichever n8n you mean to update (prod is the usual case):
#   N8N_API_URL=https://n8n.indicex.xyz   # or http://localhost:5678 for the local dev n8n
# The key is created in the n8n editor: Settings -> n8n API -> Create an API key.
# N8N_API_URL=https://n8n.indicex.xyz
# N8N_API_KEY=

# Explainer videos (/video). The pipeline has TWO independent model seams and they
# need DIFFERENT keys, which is the thing to get right here:
#   - the storyboard FRAMES  -> VIDEO_IMAGE_PROVIDER (Gemini/"Nano Banana" by default)
#   - the animated CLIPS     -> VIDEO_CLIP_PROVIDER  (Kling below)
# So a Kling-clips deployment STILL needs GEMINI_API_KEY for the frames, while the
# animate gate checks the CLIP provider's key and no longer looks at Gemini at all.
# Needs a PAID Gemini API key. Get one at aistudio.google.com.
# THE SAME KEY reads /chat's document attachments (CHAT_OCR_PROVIDER above), so a
# deployment with no /video at all still needs it unless chat is put back on
# sarvam/openai.
# GEMINI_API_KEY=
# Which backend renders scene clips (optional, default veo). Both are implemented,
# so trading them is an .env edit and a restart, with no code change
# (packages/content-engine/src/video/clip-provider.ts). Switching providers or
# resolutions changes the frame SIZE of new clips — re-animate ALL scenes of any
# project you then touch, or the stitch concatenates mixed-size clips.
VIDEO_CLIP_PROVIDER=kling
# Which backend renders the video's storyboard FRAMES — the दृश्यांची नमुना चित्रे
# step (optional, default gemini). This is a one-line switch, no redeploy and no
# code change (packages/content-engine/src/video/frame-provider.ts):
#   gemini = "Nano Banana", which takes the video aspect natively so frames are
#            not centre-cropped. Needs GEMINI_API_KEY.
#   openai = ChatGPT's gpt-image (OPENAI_IMAGE_MODEL, default gpt-image-2), the
#            same model the posters use. Needs OPENAI_API_KEY. It renders 3:2 /
#            2:3 and is centre-cropped to the video aspect afterwards, and it
#            bills per image at OPENAI_IMAGE_QUALITY.
# Both paths render the same three shapes — a start frame, the end frame EDITED
# from it, and an earlier scene's frame attached as the cross-scene world
# reference — so the choice is cost/look, not capability. The storyboard gate
# checks whichever key the CONFIGURED provider needs, so a gpt-image deployment
# does not need GEMINI_API_KEY for frames (Veo clips would still need it).
# Poster rendering is unaffected either way. Kling is deliberately NOT an option
# here — it is used for video clips only.
VIDEO_IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
#
# Kling 3.0 (the OFFICIAL klingai.com API, on its model-specific endpoints — not a
# reseller, and not the legacy /v1 AK/SK JWT flow). Auth is a plain API key created
# in the Kling console; there is no request signing. Required when
# VIDEO_CLIP_PROVIDER=kling, or the animate gate returns a Marathi 503 naming it.
KLING_API_KEY=
# KLING_BASE_URL=https://api-singapore.klingai.com  # docs moved it off api.klingai.com
# KLING_MODEL=kling-3.0                             # the model id is in the URL path
# Output resolution. UNSET => tier-driven (संतुलित/fast 720p, सर्वोत्तम/standard 1080p).
# SET => it wins for every tier, which is what "720p for now" means. Unlike Veo this
# is a real cost lever: Kling bills per second BY resolution (6 credits/s at 720p with
# audio off, 8 at 1080p), so changing it means re-pricing
# VIDEO_TIER_PRICE_PER_SECOND_USD in packages/schemas/src/video.ts.
KLING_RESOLUTION=720p
# KLING_POLL_INTERVAL_MS=10000      # task poll cadence
# KLING_RENDER_TIMEOUT_MS=600000    # per-clip wall clock before the scene fails
# KLING_MAX_CONCURRENCY=1           # per-account task slots come from the resource package
# KLING_MAX_RETRIES=5
# KLING_REQUEST_TIMEOUT_MS=120000
# Veo knobs (all optional — defaults shown), used only when VIDEO_CLIP_PROVIDER=veo.
# The preview model ids churn; a rename is an .env edit, not a deploy. NOTE:
# first+last-frame interpolation (the realistic start/end flow) only works on the 3.1
# standard + fast models — the lite preview rejects lastFrame and renders from the
# start frame alone (logged, never fatal).
# VEO_MODEL_STANDARD=veo-3.1-generate-preview
# VEO_MODEL_FAST=veo-3.1-fast-generate-preview
# VEO_MODEL_LITE=veo-3.1-lite-generate-preview
# Output resolution. Veo bills per SECOND, not per pixel, so 1080p costs the same as
# 720p where the model/aspect supports it; a model that rejects it falls back with a
# warning rather than failing the render. Vertical 9:16 is 720p-only on some previews.
# VEO_RESOLUTION=1080p
# VEO_POLL_INTERVAL_MS=10000        # long-running operation poll cadence
# VEO_RENDER_TIMEOUT_MS=600000      # per-clip wall clock before the scene fails
# Gemini traffic runs in TWO lanes with separate pools and clocks, because the two
# endpoints behave nothing alike: a Veo call starts or polls an operation and answers
# in milliseconds under low preview rate limits, while one storyboard frame from Nano
# Banana takes minutes — longer still when it carries an inline reference image — and
# several can safely be in flight. Sharing one limiter queued every frame behind the
# Veo setting; sharing one timeout failed frames that were merely slow.
# GEMINI_MAX_CONCURRENCY=1          # Veo lane. Preview rate limits are LOW — keep at 1
# GEMINI_REQUEST_TIMEOUT_MS=120000  # Veo lane
# GEMINI_IMAGE_MAX_CONCURRENCY=3    # frame lane
# GEMINI_IMAGE_TIMEOUT_MS=300000    # frame lane
# How many frames the storyboard job renders at once. Scene 1 always renders alone
# first — it is every later scene's world reference.
# VIDEO_FRAME_CONCURRENCY=3
# Retries for a SERVER-sent failure (429/5xx). A TIMEOUT is capped at 2 attempts
# regardless: aborting the socket does not cancel the generation, so burning this
# whole budget on a slow model just bills you five more times and delays the failure.
# GEMINI_MAX_RETRIES=5
# ffmpeg override for the video stitch (optional): the ffmpeg-static npm binary is
# used by default; set this if that download was blocked in the docker build
# (apt-get install ffmpeg; FFMPEG_PATH=/usr/bin/ffmpeg).
# FFMPEG_PATH=

# Direct publishing to the OFFICIAL social accounts (the detail-page "post" button
# on twitter/facebook runs). All optional: when a platform's values are missing the
# publish endpoint returns a Marathi 503 telling the user to configure them — nothing
# else breaks. Setup walkthrough for both platforms: docs/social-publishing-setup.md.
#
# X (Twitter): OAuth 1.0a user-context keys of the official account, from a
# developer.x.com app whose permissions were set to "Read and Write" BEFORE the
# access token was generated. Free tier allows roughly 500 posts/month.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
#
# Facebook: the official Page's id + a long-lived (non-expiring) Page access token
# with pages_manage_posts (+ pages_read_engagement). A dev-mode Meta app works for
# testing as long as the Page admin has a role on the app.
# NOTE: FACEBOOK_PAGE_ACCESS_TOKEN must be the PAGE token from GET /me/accounts —
# NOT the User token from the Graph API Explorer. Both start with EAA... and the
# user token even carries pages_manage_posts, but publishing with it fails at post
# time with the misleading "(#200) publish_actions ... deprecated". Verify with
# GET /debug_token: it must say "type": "PAGE" and "expires_at": 0 (never expires).
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_API_VERSION=v23.0

