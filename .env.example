SUPABASE_URL
SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY
CANVA_CLIENT_ID
CANVA_CLIENT_SECRET

# OpenAI models (all optional — defaults shown). Every OpenAI text/vision call in the repo
# runs on the gpt-5.6 family, in two tiers. Changing models is an edit HERE, not in code.
#
#   OPENAI_CHAT_MODEL     — authoring + judgement: article generation and revision, the
#                           coverage/faithfulness checks, captions, proof-read. The default
#                           for any call that does not name a model.
#   OPENAI_UTILITY_MODEL  — mechanical work whose answer a deterministic step re-checks:
#                           master ranking tie-breaks, page-instruction parsing, offline
#                           finetune data prep.
#   OPENAI_VISION_MODEL   — image-input calls (poster feedback markers, master analysis).
#                           MUST be vision-capable.
#   OPENAI_VIDEO_MODEL    — the /video pipeline's TEXT calls (scene planning, script
#                           writing, narration shortening, coverage checks), pinned one
#                           step up because they are the judgement-heaviest Marathi work.
#                           Text only: the clips stay on Kling and the frames on Gemini.
#   OPENAI_ARTICLE_MODEL  — the SIMPLIFIED article generator's single call (see
#                           ARTICLE_GENERATION_MODE below). Pinned one step up for the same
#                           reason as the video tier: with the brief, the coverage loop and
#                           the faithfulness repair removed, all of that judgement now
#                           happens inside this one call.
#   OPENAI_POINTERS_MODEL — /dlo's महत्त्वाचे मुद्दे summary. Pinned one step up because
#                           enumerating every distinct topic across a 60k-char multi-article
#                           document, in order and without repeating itself, is a
#                           judgement-heavy read — and it is the officer's only view of what
#                           a long scanned source says. Dropping it to terra halves the
#                           per-run cost (~$0.10 short note / ~$0.40-0.50 long PDF on sol).
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_UTILITY_MODEL=gpt-5.6-luna
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_VIDEO_MODEL=gpt-5.6-sol
# OPENAI_ARTICLE_MODEL=gpt-5.6-sol
# OPENAI_POINTERS_MODEL=gpt-5.6-sol
#
# Rollback lever: setting these three to gpt-4o / gpt-4o-mini / gpt-4o-mini restores the
# pre-5.6 behaviour exactly (the pre-gpt-5 request body is preserved byte-for-byte).
#
# gpt-5.6 notes that matter operationally:
#  - `temperature` is REJECTED, so the temperature-0 determinism ~24 call sites used to
#    rely on is gone. Reasoning effort ('medium' by default) is the replacement quality
#    lever; the deterministic post-filters (proof-read's verbatim-excerpt + digit guards,
#    lock-scheme-names, the translate name repair, the video fact_index grounding) are
#    what actually hold the line and are unchanged.
#  - Reasoning tokens are billed at the OUTPUT rate and come out of the same completion
#    budget as the answer, so expect a real cost increase per article vs gpt-4o. The
#    per-run number lands in generations.cost_usd.

# Which article pipeline runs for news/scheme generation (optional — default 'simple').
#
#   simple  the single-call baseline: one style reference, one call on OPENAI_ARTICLE_MODEL,
#           one article. No 5W1H extraction, no editorial brief, no tier audit, no sectioned
#           drafting, no coverage-revision loop, no faithfulness repair, no traceability
#           appendix. ~1 chat call instead of up to 14.
#   full    the previous multi-stage editorial pipeline, unchanged. generate-article.ts and
#           every stage module it calls are untouched, so this restores the old behaviour —
#           and the old model — exactly.
#
# Everything deterministic and everything officer-approved survives in BOTH modes: the
# designation pass, and — for generations created while /dlo's Pointers step was a 5W1H
# checkbox list — the stored approved inventory, attributed statements and excluded facts.
# New /dlo runs no longer carry an inventory: Pointers is now a read-only summary and the
# article is written from the complete reviewed text.
# ARTICLE_GENERATION_MODE=full

# Publication place used in the mandatory dateline at the start of every generated NEWS body.
# The date is always today's day-of-month in Asia/Kolkata and is rendered in Devanagari digits
# (for example, "मुंबई, दि. २९ :"). Scheme articles and officer-provided finished articles are
# unchanged. Optional — default 'मुंबई'.
# ARTICLE_NEWS_DATELINE_LOCATION=मुंबई

# Which editorial specification writes that article (optional — default 'standard').
# Independent of ARTICLE_GENERATION_MODE above: that chooses the PIPELINE, this chooses the
# PROMPT the single call runs.
#
#   standard  the full DGIPR specification (simple-article-prompt.ts, ~6,900 chars): structure
#             guidance, ordering rules, terminology examples.
#   minimal   the experiment (minimal-article-prompt.ts, ~830 chars): the note, the style
#             exemplars, the verified name dictionary, and five sentences of instruction.
#
# NEITHER states a word target any more (simple-v3, 2026-07-28: the count and the acceptable
# range came out of the standard specification too — a stated number is an instruction the model
# obeys against the material, padding a thin note and truncating a rich one). Length is
# inherited from the exemplars, which are themselves bounded by styleReferenceMaxChars() in
# select-style-reference.ts (ARTICLE_WORD_TARGETS[category].max x 6.5 x 2). If articles come out
# the wrong length in EITHER variant, THAT bound is the knob, not a sentence in the prompt.
#
# Everything outside the prompt is identical between the two — same reference selection, same
# model, same deterministic designation pass — which is what makes them comparable. Each run
# records which one wrote it in generations.style_reference_meta.promptVersion
# ('simple-v3' vs 'minimal-v1').
# ARTICLE_PROMPT_VARIANT=minimal

# Deliberation for that one call (optional — default 'high'; none | low | medium | high).
# This is the knob that replaced the removed grading passes, and it matters more under the
# minimal variant, where the specification is five sentences and the judgement that used to be
# spread over fourteen calls has nowhere else to happen. 'high' costs latency, not correctness;
# set 'medium' to restore the previous default. Compare levels on real notes with
# `pnpm --filter @dgipr/content-engine article:compare -- --effort=high`.
# OPENAI_ARTICLE_REASONING_EFFORT=high

# Minimum cosine similarity (0..1) a retrieved Mahasamvad article must reach before it is used
# as the style reference (optional — default 0.35). Below the floor the article is generated
# from the DGIPR rules alone, which is better than being shown an unrelated exemplar and told
# to follow its structure. CALIBRATE THIS against the live corpus rather than guessing: run
# `pnpm --filter @dgipr/content-engine retrieve:test` over real notes to see the distribution,
# and read generations.style_reference_meta to see what production runs actually matched.
# ARTICLE_STYLE_REFERENCE_MIN_SIMILARITY=0.35

# Model for the poster's reference selection + visible Marathi copy + art direction. Split from
# OPENAI_CHAT_MODEL so the poster path can be tuned for latency independently — set it to
# gpt-5.6-luna to trade some copy quality for a faster render.
# OPENAI_COPY_MODEL=gpt-5.6-terra

# How an ordinary (unpinned, non-CMO) social poster picks its reference template
# (optional — default 'information').
#
#   information  INFORMATION-FIRST. The raw note is compared against EVERY enabled master of
#                the brand — across all types — using each master's cached informational
#                description (reference_images.layout_spec), and the best-fitting reference
#                wins. The poster type is then read off the chosen reference, and the copy
#                step arranges the note's information into the sections that reference
#                actually has. Nothing about the note is predicted beforehand.
#   classify     LEGACY. Classify the note into a post type and read point_count +
#                wants_photo off the same call, then score masters WITHIN that type. Every
#                prediction made there constrained the pool before a reference had been
#                looked at: a wrong point_count excluded the right template, a wrong
#                post_type excluded a whole family of them.
#
# One un-analysed master is warmed per run on BOTH paths, but information-first can only rank
# masters that already carry a description — so run
# `pnpm --filter @dgipr/content-engine analyze:references` to backfill the library, or early
# runs fall back to the seeded pick.
# SOCIAL_REFERENCE_MODE=classify

# OpenAI transport (all optional — defaults shown). Every chat/embedding call is serialized
# process-wide and retried on transient failures (429 / 408 / 409 / 5xx / network), preferring
# the wait OpenAI names in its retry-after / x-ratelimit-reset-* headers.
# One scheme article is 8-15 calls carrying the full note and article (~5-8k tokens each),
# so at OpenAI usage tier 1 (30,000 TPM) concurrency MUST stay at 1 — two in-flight requests
# will trip the token bucket. Reasoning tokens count toward TPM too, so this matters MORE on
# gpt-5.6, not less. Raise it only on tier 2+ (450k TPM), where it restores real
# parallelism to the coverage checks and cuts wall-clock noticeably.
#
# THIS IS THE KNOB THAT DECIDES WHETHER SEVERAL OFFICERS CAN WORK AT ONCE. /dlo now supports
# concurrent intakes (each at its own /dlo/[id]), but every OpenAI call in the process still
# queues through this limiter — so at 1, a second officer's pointer summary or article simply
# waits behind the first with no sign of why. Recommended deployment value: 5, and ONLY on
# tier 2+. The arithmetic: an article is ~120k tokens spread over minutes, so five officers
# aggregate to roughly 150k TPM in steady state; the exposure is the burst case (five large
# calls in one minute, ~600k), which retry-with-backoff absorbs. Expect
# "[openai] ... got 429" warnings to become ROUTINE at 5 — that is the mechanism working, but
# it does mean the log stops being a useful signal that something is wrong. If throughput
# feels worse rather than better, that is the symptom of overshooting the tier: drop to 3.
# On tier 1, raising this makes things worse. Rollback is this one line.
# OPENAI_MAX_CONCURRENCY=1
# OPENAI_MAX_RETRIES=5              # retries AFTER the first attempt
# Per-request timeout; a hung call would otherwise block the serialized queue. Raised from
# 180000 for gpt-5.6: a full-length Marathi article body at 'medium' reasoning can run
# longer than 3 minutes, and this timeout aborts it mid-generation.
# DEPLOYMENT CHECK: /api/pointers is synchronous, so a queued request can hold an HTTP
# connection open for this long plus queue time. Confirm the reverse proxy's idle timeout is
# >= 310s, or lower this to fit under it — otherwise the proxy 504s and throws away a call
# that has already been paid for.
# OPENAI_REQUEST_TIMEOUT_MS=300000

# NOTE: the API must run as EXACTLY ONE process. The detail routes reap "orphaned" jobs by
# checking an in-process set (see apps/api/src/routes/dlo.ts), so a second instance behind a
# load balancer would mark healthy jobs running on the first instance as failed. Scaling
# horizontally requires replacing that check with a heartbeat + grace window in dlo-runner.ts,
# runner.ts and video-runner.ts alike.

# Sarvam API key — REQUIRED for the DLO intake flow (/dlo: batch speech-to-text of
# meeting MP3s + document digitization of PDFs), and also used by the optional polish
# (below) and the translation feature. Get it from dashboard.sarvam.ai.
# SARVAM_API_KEY=sk_xxx
# DLO intake timeouts (optional — defaults shown): overall ceiling per Sarvam batch
# STT job / per document-digitization job before the file is marked failed.
# SARVAM_STT_TIMEOUT_MS=1200000     # 20 min
# SARVAM_DOC_TIMEOUT_MS=600000      # 10 min

# Optional Marathi editor-polish via Sarvam-30B (off by default). Improves flow/tone only,
# never facts; the existing faithfulness check runs after it. Requires SARVAM_API_KEY when on.
# Sarvam models are hybrid-reasoning; reasoning is disabled by default here (it only burns
# the token budget on a copy-edit task). Both knobs below are optional — defaults shown.
# ENABLE_SARVAM_POLISH=true
# SARVAM_MODEL=sarvam-30b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1/chat/completions
# SARVAM_MAX_TOKENS=4096            # budget covers reasoning + reply; Sarvam's default 2048 is too low.
#                                  # NOTE: the starter tier caps sarvam-30b max_tokens at 4096 — do not
#                                  # raise this above your plan's limit or requests 400.
# SARVAM_REASONING_EFFORT=none      # none|low|medium|high — 'none' disables thinking (default)

# Marathi→HINDI translation uses Sarvam's dedicated translation endpoint, not the chat model
# above (the chat model returns the Marathi unchanged when asked for Hindi). Needs only
# SARVAM_API_KEY; both knobs are optional overrides — defaults shown.
# SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Explainer-video narration (\video → "निवेदनाचा आवाज जोडा") uses Sarvam TTS (bulbul) to
# voice each scene's Marathi narration. Needs only SARVAM_API_KEY; both knobs are optional —
# defaults shown. If the account lacks bulbul:v3 access, set SARVAM_TTS_MODEL=bulbul:v2 and a
# v2 speaker (e.g. anushka). Voice ids: dashboard.sarvam.ai / the TTS docs.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh           # v3's own default voice; measured, authoritative
# 44100 matches what the ffmpeg mux resamples to anyway, so asking for it removes an
# upsample. v3 accepts up to 48000 over REST.
# SARVAM_TTS_SAMPLE_RATE=44100
# Lower than Sarvam's 0.6 default: steadier reads across eight scenes matter more than
# expressiveness here, and higher values are documented to introduce artifacts. v3 only.
# SARVAM_TTS_TEMPERATURE=0.5
# Retired knob (kept for reference): clip windows are no longer fitted to measured
# narration — every scene is the fixed 8s interpolation window, and an overrunning
# narration is SHORTENED (and re-synthesized) rather than sped up. The env var is unread;
# the real budget lives in packages/schemas/src/video.ts
# (VIDEO_NARRATION_TARGET_SECONDS / _FIT_SECONDS).
# VIDEO_NARRATION_CHARS_PER_SECOND=32

# apps/api (all optional — defaults shown)
# HOST=127.0.0.1
# PORT=3001
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Poster background image (all optional). The image model now paints ONLY a text-free
# photo; the poster's Marathi text/header/footer are typeset in HTML and screenshotted
# with Chromium, so Devanagari is always crisp regardless of the image model.
# OPENAI_IMAGE_MODEL defaults to gpt-image-1.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1536x1024   # landscape scene, cover-cropped into the photo zone
# OPENAI_IMAGE_QUALITY=high

# Model for the reference-master vision analysis (analyze:references / on-demand analysis).
# It reads a master's layout AND its subject off the image, so it MUST be VISION-capable.
# Defaults to gpt-5.6-terra (keeps Marathi in Devanagari; runs once per master and is cached).
# If a gpt-5.6 model ever rejects image input, set this to gpt-4o (also vision-capable).
# OPENAI_ANALYZE_MODEL=gpt-5.6-terra

# n8n social-post workflow (webhook trigger of social-post-v2-api). Required for the
# 'twitter' generation category — the API's background job POSTs meeting notes here and
# awaits { post_type, title, caption, poster_png_base64 }. The workflow is host-independent:
# it fetches its brand templates over HTTPS from Supabase (posters/references/*), so the
# same exported JSON (n8n/workflow-exports/social-post-v2-api.json) runs locally and on AWS.
#   LOCAL:  http://localhost:5678/webhook/dgipr-social-post
#   AWS:    the deployed n8n webhook URL — a private VPC address if the API and n8n share a
#           network, otherwise the public HTTPS URL of the n8n instance.
N8N_SOCIAL_POST_WEBHOOK_URL=http://localhost:5678/webhook/dgipr-social-post
# n8n webhook for the ARTICLE poster (news/scheme, outputType poster/both). Like the
# social-post workflow, the API sends only { headline, scene_brief, generation_id } and
# n8n *only renders*: it edits the master-article template (posters/references/master-
# article.png, fetched over HTTPS) with gpt-image-2 and returns { poster_png_base64 }.
# The exported JSON is n8n/workflow-exports/article-poster-v1-api.json.
#   LOCAL:  http://localhost:5678/webhook/dgipr-article-poster
#   AWS:    the deployed n8n webhook URL (private VPC address if shared network, else public HTTPS).
N8N_ARTICLE_POSTER_WEBHOOK_URL=http://localhost:5678/webhook/dgipr-article-poster
# Article poster renderer: 'n8n' (default) renders via the workflow above; 'html' uses the
# original local AI-photo + HTML/Playwright render (packages/poster-renderer). Only the
# 'html' path produces a separate scene image, so poster feedback / manual copy-edit
# (which need a scenePath) work only in 'html' mode.
# ARTICLE_POSTER_MODE=n8n
# Base URL of THIS api, reachable from n8n. Used to build the progress_url that n8n
# pings after each stage (local: http://localhost:3001; on AWS the API's internal URL).
API_PUBLIC_URL=http://localhost:3001
# Shared secret between the API and n8n. When set, the API sends it as the
# x-n8n-webhook-secret header on the webhook call. To ENFORCE it on the n8n side (AWS),
# set the workflow's Webhook node Authentication to "Header Auth" and create a Header Auth
# credential with Name = x-n8n-webhook-secret and Value = this secret — n8n then rejects
# mismatches with 403 before the workflow runs. (This keeps the secret in an n8n credential,
# not in the committed workflow JSON, and needs no in-node env access.) Leave unset locally:
# with Header Auth off, the webhook is open, which is fine behind localhost.
# N8N_WEBHOOK_SECRET=

# Shipping workflow changes to a running n8n (`pnpm n8n:push`). n8n stores workflows in its
# own database, NOT on disk — a `git pull` on the n8n host changes nothing. `pnpm n8n:push`
# pushes n8n/workflow-exports/*.json into the instance below over its public REST API,
# matching by workflow name and preserving that instance's credential ids + webhook Header
# Auth. Point it at whichever n8n you mean to update (prod is the usual case):
#   N8N_API_URL=https://n8n.indicex.xyz   # or http://localhost:5678 for the local dev n8n
# The key is created in the n8n editor: Settings -> n8n API -> Create an API key.
# N8N_API_URL=https://n8n.indicex.xyz
# N8N_API_KEY=

# Explainer videos (/video). The pipeline has TWO independent model seams and they
# need DIFFERENT keys, which is the thing to get right here:
#   - the storyboard FRAMES  -> VIDEO_IMAGE_PROVIDER (Gemini/"Nano Banana" by default)
#   - the animated CLIPS     -> VIDEO_CLIP_PROVIDER  (Kling below)
# So a Kling-clips deployment STILL needs GEMINI_API_KEY for the frames, while the
# animate gate checks the CLIP provider's key and no longer looks at Gemini at all.
# Needs a PAID Gemini API key. Get one at aistudio.google.com.
# GEMINI_API_KEY=
# Which backend renders scene clips (optional, default veo). Both are implemented,
# so trading them is an .env edit and a restart, with no code change
# (packages/content-engine/src/video/clip-provider.ts). Switching providers or
# resolutions changes the frame SIZE of new clips — re-animate ALL scenes of any
# project you then touch, or the stitch concatenates mixed-size clips.
VIDEO_CLIP_PROVIDER=kling
# Which backend renders the video's storyboard FRAMES (optional, default gemini —
# "Nano Banana", which takes the video aspect natively so frames are not centre-cropped,
# and whose image EDITING is what holds a scene's start/end pair inside one shot).
# Set 'openai' to go back to gpt-image with no redeploy
# (packages/content-engine/src/video/frame-provider.ts). Poster rendering is unaffected.
# Kling is deliberately NOT an option here — it is used for video only.
# VIDEO_IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
#
# Kling 3.0 (the OFFICIAL klingai.com API, on its model-specific endpoints — not a
# reseller, and not the legacy /v1 AK/SK JWT flow). Auth is a plain API key created
# in the Kling console; there is no request signing. Required when
# VIDEO_CLIP_PROVIDER=kling, or the animate gate returns a Marathi 503 naming it.
KLING_API_KEY=
# KLING_BASE_URL=https://api-singapore.klingai.com  # docs moved it off api.klingai.com
# KLING_MODEL=kling-3.0                             # the model id is in the URL path
# Output resolution. UNSET => tier-driven (संतुलित/fast 720p, सर्वोत्तम/standard 1080p).
# SET => it wins for every tier, which is what "720p for now" means. Unlike Veo this
# is a real cost lever: Kling bills per second BY resolution (6 credits/s at 720p with
# audio off, 8 at 1080p), so changing it means re-pricing
# VIDEO_TIER_PRICE_PER_SECOND_USD in packages/schemas/src/video.ts.
KLING_RESOLUTION=720p
# KLING_POLL_INTERVAL_MS=10000      # task poll cadence
# KLING_RENDER_TIMEOUT_MS=600000    # per-clip wall clock before the scene fails
# KLING_MAX_CONCURRENCY=1           # per-account task slots come from the resource package
# KLING_MAX_RETRIES=5
# KLING_REQUEST_TIMEOUT_MS=120000
# Veo knobs (all optional — defaults shown), used only when VIDEO_CLIP_PROVIDER=veo.
# The preview model ids churn; a rename is an .env edit, not a deploy. NOTE:
# first+last-frame interpolation (the realistic start/end flow) only works on the 3.1
# standard + fast models — the lite preview rejects lastFrame and renders from the
# start frame alone (logged, never fatal).
# VEO_MODEL_STANDARD=veo-3.1-generate-preview
# VEO_MODEL_FAST=veo-3.1-fast-generate-preview
# VEO_MODEL_LITE=veo-3.1-lite-generate-preview
# Output resolution. Veo bills per SECOND, not per pixel, so 1080p costs the same as
# 720p where the model/aspect supports it; a model that rejects it falls back with a
# warning rather than failing the render. Vertical 9:16 is 720p-only on some previews.
# VEO_RESOLUTION=1080p
# VEO_POLL_INTERVAL_MS=10000        # long-running operation poll cadence
# VEO_RENDER_TIMEOUT_MS=600000      # per-clip wall clock before the scene fails
# GEMINI_MAX_CONCURRENCY=1          # Veo preview rate limits are LOW — keep at 1
# GEMINI_MAX_RETRIES=5
# GEMINI_REQUEST_TIMEOUT_MS=120000
# ffmpeg override for the video stitch (optional): the ffmpeg-static npm binary is
# used by default; set this if that download was blocked in the docker build
# (apt-get install ffmpeg; FFMPEG_PATH=/usr/bin/ffmpeg).
# FFMPEG_PATH=

# Direct publishing to the OFFICIAL social accounts (the detail-page "post" button
# on twitter/facebook runs). All optional: when a platform's values are missing the
# publish endpoint returns a Marathi 503 telling the user to configure them — nothing
# else breaks. Setup walkthrough for both platforms: docs/social-publishing-setup.md.
#
# X (Twitter): OAuth 1.0a user-context keys of the official account, from a
# developer.x.com app whose permissions were set to "Read and Write" BEFORE the
# access token was generated. Free tier allows roughly 500 posts/month.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
#
# Facebook: the official Page's id + a long-lived (non-expiring) Page access token
# with pages_manage_posts (+ pages_read_engagement). A dev-mode Meta app works for
# testing as long as the Page admin has a role on the app.
# NOTE: FACEBOOK_PAGE_ACCESS_TOKEN must be the PAGE token from GET /me/accounts —
# NOT the User token from the Graph API Explorer. Both start with EAA... and the
# user token even carries pages_manage_posts, but publishing with it fails at post
# time with the misleading "(#200) publish_actions ... deprecated". Verify with
# GET /debug_token: it must say "type": "PAGE" and "expires_at": 0 (never expires).
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_API_VERSION=v23.0

