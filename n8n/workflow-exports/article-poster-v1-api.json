{
  "name": "article-poster-v1-api",
  "nodes": [
    {
      "id": "w1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-240, 0],
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "dgipr-article-poster",
        "responseMode": "responseNode"
      },
      "webhookId": "c1d2e3f4-0001-4abc-8def-000000000101"
    },
    {
      "id": "s1",
      "name": "Article Poster Form",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-20, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "generation_id",
              "type": "string",
              "value": "={{ $json.body.generation_id }}"
            },
            {
              "id": "a2",
              "name": "image_url",
              "type": "string",
              "value": "={{ $json.body.image_url || $json.body.reference_url }}"
            },
            {
              "id": "a3",
              "name": "prompt",
              "type": "string",
              "value": "={{ $json.body.prompt }}"
            },
            {
              "id": "a4",
              "name": "quality",
              "type": "string",
              "value": "={{ $json.body.quality || 'medium' }}"
            }
          ]
        },
        "includeOtherFields": false,
        "mode": "manual",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Read Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [200, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "master"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "n3",
      "name": "Edit Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [420, 0],
      "parameters": {
        "authentication": "genericCredentialType",
        "bodyParameters": {
          "parameters": [
            {
              "inputDataFieldName": "master",
              "name": "image",
              "parameterType": "formBinaryData"
            },
            {
              "name": "model",
              "parameterType": "formData",
              "value": "gpt-image-2"
            },
            {
              "name": "prompt",
              "parameterType": "formData",
              "value": "={{ $('Article Poster Form').first().json.prompt }}"
            },
            {
              "name": "size",
              "parameterType": "formData",
              "value": "1536x1024"
            },
            {
              "name": "quality",
              "parameterType": "formData",
              "value": "={{ $('Article Poster Form').first().json.quality }}"
            },
            { "name": "n", "parameterType": "formData", "value": "1" }
          ]
        },
        "contentType": "multipart-form-data",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "options": { "timeout": 360000 },
        "sendBody": true,
        "url": "https://api.openai.com/v1/images/edits"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenAI Bearer (DGIPR)"
        }
      }
    },
    {
      "id": "r1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [640, 0],
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ poster_png_base64: $json.data[0].b64_json }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "index": 0, "node": "Article Poster Form", "type": "main" }]]
    },
    "Article Poster Form": {
      "main": [[{ "index": 0, "node": "Read Image", "type": "main" }]]
    },
    "Read Image": {
      "main": [[{ "index": 0, "node": "Edit Image", "type": "main" }]]
    },
    "Edit Image": {
      "main": [[{ "index": 0, "node": "Respond to Webhook", "type": "main" }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {},
  "tags": []
}
